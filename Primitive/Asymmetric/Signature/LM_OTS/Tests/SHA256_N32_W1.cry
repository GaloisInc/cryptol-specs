/**
 * Test the SHA256 FFI N32 W1 LMS OTS instance.
 * This uses generated test vectors from the Trail of Bits LMS Go Package.
 * @see https://github.com/trailofbits/lms-go
 *
 * @copyright Galois, Inc.
 * @author John Christensen <jchristensen@galois.com>
 */
module Primitive::Asymmetric::Signature::LM_OTS::Tests::SHA256_N32_W1 where

import Primitive::Asymmetric::Signature::LM_OTS::Instantiations::SHA256_N32_W1 as W1

/**
 * ```
 * :check message == "Deterministic test message for Leighton-Micali OTS verification."
 * ```
 */
message = groupBy `{8} 0x44657465726d696e69737469632074657374206d65737361676520666f72204c65696768746f6e2d4d6963616c69204f545320766572696669636174696f6e2e

SEED_W1 = 0x558b8966c48ae9cb898b423c83443aae014a72f1b1ab5cc85cf1d892903b5439
ID_W1 = groupBy `{8} 0xd08fabd4a2091ff0a8cb4ed834e74534
q_W1 = 0 : [32]
x_W1 = groupBy `{8} 
private_W1 = groupBy `{8} 
public_W1 = groupBy `{8} 0x00000001d08fabd4a2091ff0a8cb4ed834e7453400000000521121ce81c506ff84e63c7062ce019144d7d6e7e95577d4bff8be8f3bf74b8a
C_W1 = groupBy `{8} 0xcebd89745edf5acac83c6f1c96683794727c60f17be33f1b896e5cdb426fbe24
signature_W1 = groupBy `{8} 

/**
 * The given x is actually generated with the expected hash function.
 * ```
 * :check privateKeyFromSeedCorrect
 * ```
 */
property privateKeyFromSeedCorrect = W1::privateKeyGeneration ID_W1 q_W1 (split f) == private_W1
    where
        f = W1::pseudoRandomKeyGeneration ID_W1 q_W1 (split SEED_W1)

/**
 * The private key is correct.
 * ```
 * :check privateKeyCorrectW1
 * ```
 */
property privateKeyCorrectW1 = W1::privateKeyGeneration ID_W1 q_W1 (split x_W1) == private_W1

/**
 * The public key is correct.
 * ```
 * :check publicKeyCorrectW1
 * ```
 */
property publicKeyCorrectW1 = W1::publicKeyGeneration (W1::privateKeyGeneration ID_W1 q_W1 (split x_W1)) == public_W1

/**
 * The signature is correct.
 * ```
 * :check signatureCorrectW1
 * ```
 */
property signatureCorrectW1 = W1::signatureGeneration private_W1 message C_W1 == signature_W1

/**
 * The signature can be verified with the public key.
 * ```
 * :check verificationCorrectW1
 * ```
 */
property verificationCorrectW1 = W1::verifySignature signature_W1 message public_W1
