/**
 * The Leighton-Micali Hash Based Signature (LMS) requires
 * an LM-OTS signature (Leighton-Micali One Time Signature).
 *
 * Reference:
 * [LMS] RFC 8554: Leighton-Micali Hash-Based Signatures
 *       McGrew, Curcio, Fluhrer.
 *       April 1, 2019.
 *       @see https://doi.org/10.17487/RFC8554
 *
 * [NIST] NIST SP800-208: Recommendation for Stateful Hash Based Signature Schemes.
 *        Cooper et. al.
 *        October 2020
 *        @see https://doi.org/10.6028/NIST.SP.800-208
 */
module Primitive::Asymmetric::Signature::LM_OTS::Specification where

import interface Primitive::Asymmetric::Signature::LM_OTS::Parameters
import interface Primitive::Keyless::Hash::HashInterface

/**
 * The LM OTS specification requires n to be the number of bytes in
 * the hash digest. We enforce this here.
 */
interface constraint (DigestLength == 8 * n)

/**
 * w is in the set {1, 2, 4, 8}, but Cryptol requires help to deduce
 * that the width of 2 ^^ w - 2 is less than or equal to 8 because
 * of the particular formulation of w.
 */
interface constraint (width (2 ^^ w - 2) <= 8)

/**
 * p is used as a loop bound where u16str is called on p.
 * We assume, then, that p can be represented as an unsigned.
 * 16 bit integer.
 */
interface constraint (width p <= 16)

/**
 * A hash function is iterated to create the LM OTS public key.
 * The argument that is hashed must have length less than or equal
 * to the maximum length that can be accepted by the hash.
 * For all intents and purposes, this constraint is "trivial", but
 * is required to satisfy Cryptol's typechecker.
 */
interface constraint (width (8 * (23 + n)) < MessageUpperBound)
interface constraint (width (8 * (22 + n * p)) < MessageUpperBound)

/**
 * The private key is a:
 * - typecode
 * - tree ID
 * - leaf ID
 * - private key array
 */
type PrivateKeyLen = 4 + 16 + 4 + (p * n)

/**
 * The public key is a:
 * - typecode
 * - a tree ID
 * - a leaf ID
 * - some "key component"
 */
type PublicKeyLen = 4 + 16 + 4 + n

/**
 * The signature is a:
 * - a typecode
 * - a nonce ("randomizer")
 * - a sequence of p hashes
 */
type SignatureLen = 4 + n + p * n

/**
 * A typecode is a 32 bit number.
 */
type Typecode = [32]

/**
 * Private key generation. This corresponds to Algorithm 0 in Section 4.2 of [LMS].
 * This implementation intentionally deviates from the specification in the following
 * ways:
 *
 * 1. The parameters p and n are taken from the parameters file rather than a table
 * of specified values.
 *
 * 2. The "random" array x is passed in as an argument to this function, since we do
 * not model random number generation in Cryptol.
 *
 * 3. The typecode does not correspond to the specification, and is instead treated
 * as an arbitrary 32 bit value from the parameter module.
 *
 */
privateKeyGeneration: [16][8] -> [32] -> [p][n][8] -> [PrivateKeyLen][8]
privateKeyGeneration I q x = (u32str typecode) # I # (split q) # join x

/**
 * Public key generation. This corresponds to Algorithm 1 in Section 4.3 of [LMS].
 * This implementation intentionally deviates from the specification in the following
 * way:
 *
 * 1. The parameters n, p, and w are taken from the parameters file rather than
 * being determined by the typecode. This is to allow more flexible instances.
 *
 * 2. The typecode parsed from the private key is ignored.
 *
 */
publicKeyGeneration: [PrivateKeyLen][8] -> [PublicKeyLen][8]
publicKeyGeneration privateKey = pubKey
    where
        // 3. Determine x, I, and q from the private key.
        (_, I, q, x) = unpackPrivate privateKey

        // 4. Compute the string K.
        y = [publicComponent i I q (x @ i) | i <- [0..p - 1]]
        K = H (I # u32str q # u16str D_PBLC # join y)

        // 5. Return the following
        pubKey = u32str typecode # I # u32str q # K

/**
 * The LM-OTS signature of a message is generated by doing the following
 * in sequence: prepending the LMS key identifier I, the LMS leaf
 * identifier q, the value D_MESG (0x8181), and the randomizer C to the
 * message; computing the hash; concatenating the checksum of the hash
 * to the hash itself; considering the resulting value as a sequence of
 * w-bit values; and using each of the w-bit values to determine the
 * number of times to apply the function H to the corresponding element
 * of the private key.  The outputs of the function H are concatenated
 * together and returned as the signature.
 *
 * This description is lifted from Section 4.5 of [LMS].
 *
 * The following is also referred to as Algorithm 3: Geenrating a
 * One-Time Signature From a Private Key and a Message.
 *
 * We intentionally deviate from the above as follows:
 *
 * 1. The typecode is taken as an input.
 * 2. n, p, and w are taken as arbitrary parameters rather than Table 1.
 * 3. C is taken as an input rather than sampled uniformly.
 *
 */
signatureGeneration:
    {m}
    (fin m, width (8 * (22 + m + n)) < MessageUpperBound)
    => [PrivateKeyLen][8] -> [m][8] -> [n][8] -> [SignatureLen][8]
signatureGeneration privateKey message C = signature
    where
        (_, I, q, x) = unpackPrivate privateKey
        Q = H (I # u32str q # u16str D_MESG # C # message)

        // Convert Q || Cksm(Q) into a w string.
        // Convert the w string into a sequence of 8 bit values.
        Qw = map zext (wStr (Q # split (Cksm Q)))

        y = [HtIter (Qw @ i) i I q (x @ i) zero | i <- [0..p - 1]]

        signature = u32str typecode # C # join y

/**
 * In order to verify a message with its signature, the verifier
 * must "complete" the chain of iterations of H using the w-bit
 * coefficients of the string resulting from the concatenation of
 * the message hash and its checksum. This computation should result
 * in a value that matches the provided public key.
 *
 * See Section 4.6 of [LMS], Algorithm 4a + Algorithm 4b.
 *
 */
verifySignature:
    {m}
    (fin m, width (8 * (22 + m + n)) < MessageUpperBound)
    => [SignatureLen][8] -> [m][8] -> [PublicKeyLen][8] -> Bit
verifySignature s m p = case verify s m p of
                            VALID -> True
                            INVALID -> False

private

    /**
     * It should be possible to verify a signature created by some
     * private key holder with the corresponding public key.
     *
     *
     * Performance note: this is a relatively slow test, even if
     * Suite B primitives are used.
     *
     * ```
     * :check schemeOk `{8}
     * ```
     */
    schemeOk:
        {m}
        (fin m, width (8 * (22 + m + n)) < MessageUpperBound)
        => [PrivateKeyLen][8] -> [m][8] -> [n][8] -> Bit
    property schemeOk privateKey message nonce = verificationResult
        where
            verificationResult = verifySignature signature message publicKey
            publicKey = publicKeyGeneration privateKey
            signature = signatureGeneration privateKey message nonce

    /**
     * The specification uses VALID and INVALID in place
     * of a bit. We make the editorial decision to hide this
     * detail.
     */
    enum OTSResult = VALID | INVALID

    /**
     * Algorithm 4a: Verifying a Signature and Message Using a
     * Public Key.
     */
    verify:
        {m}
        (fin m, width (8 * (22 + m + n)) < MessageUpperBound)
        => [SignatureLen][8] -> [m][8] -> [PublicKeyLen][8] -> OTSResult
    verify signature message pubKey = if badPubtype
                                      then INVALID // We should be using a different parameter set.
                                      else case Kc of
                                        Err _ -> INVALID // An error while computing the candidate.
                                        Ok kc -> if kc == K
                                                 then VALID
                                                 else INVALID
        where
            // 1. If the public key is not at least four bytes long,
            // return INVALID.

            // This case is precluded by the type definition.

            // 2. Parse pubtype, I, q, and K from the public key.

            // a. Parse pubtype
            (pubtype, remPk0) = (strTou32 (take `{4} pubKey), drop `{4} pubKey)

            // b. Set n according to the pubkey...

            // we ignore this, since we take it as a parameter. what we will do
            // instead is check that it matches the typecode we expect.
            badPubtype = typecode != pubtype

            // c. parse I
            (I, remPk1) = (take `{16} remPk0, drop `{16} remPk0)

            // d. compute q
            (q, remPk2) = (strTou32 (take `{4} remPk1), drop `{4} remPk1)

            // e. the rest of the public key is K
            // we make the type explicit to ensure that it is exactly
            // n bytes like the type "promises".
            K = remPk2 : [n][8]

            // 3. Compute Kc
            Kc = computeKc signature message pubtype I q

    /**
     * Algorithm 4b: Computing a Public Key Candidate Kc from
     * a Signature, Message, Signature Typecode pubtype, and
     * Identifiers I, q.
     *
     * We intentionally deviate from the specification in the
     * following ways:
     *
     * 1. Algorithm 4b assumes that n and p will be set with
     * the typecode, while we assume that n and p are pre-set.
     * This means the Cryptol specification does the length checking
     * in the type system, rather than at "runtime".
     */
    computeKc:
        {m}
        (fin m, width (8 * (22 + m + n)) < MessageUpperBound)
        => [SignatureLen][8] -> [m][8] -> Typecode -> [16][8] -> [32] -> Result ([n][8]) OTSResult
    computeKc signature message pubtype I q = if badType
                                              then Err INVALID
                                              else Ok Kc
        where
            // 1. If the signature is not at least four bytes long,
            // return INVALID.

            // This case is precluded by the definition of SignatureLen

            // 2. Parse sigtype, C, and y from the signature.
            //
            // The case where the length check fails is precluded
            // by the definition of SignatureLen. To make this
            // clear, we give explicit types to C and y.

            (sigtype, rem) = (take `{4} signature, drop `{4} signature)
            (C, y) = (take `{n} rem, split (drop `{n} rem)) : ([n][8], [p][n][8])

            // if sigtype is not equal to pubtype, return INVALID.
            badType = join sigtype != pubtype

            // 3. Compute the string Kc
            Q = H (I # u32str q # u16str D_MESG # C # message)

            // Convert Q || Cksm(Q) into a w string.
            // Convert the w string into a sequence of 8 bit values.
            Qw = map (zext `{8}) (wStr (Q # split (Cksm Q)))

            z = [HtIter (2 ^^ `w - 1) i I q (y @ i) (Qw @ i) | i <- [0..p - 1]]

            Kc = H (I # u32str q # u16str D_PBLC # join z)

    /**
     * A checksum is used to ensure that any forgery attempt
     * that manipulates the elements of an existing signature
     * will be detected. See Section 4.4 of [LMS].
     *
     * This deviates from the specification because it uses ls
     * as an "unchecked" parameter, rather than one that is computed.
     */
    Cksm: [n][8] -> [16]
    Cksm S = checksum << `ls
        where
            // rather than emulating a "for loop" and using
            // coef, we instead just fold over the (zero-extended)
            // w-bit values.
            //
            // We justify zero extending by extrapolating the diagram
            // 3.1.3 to the integers rather than w-bit numbers.
            coeffs = wStr S

            // A constant.
            wc = 2 ^^ `w - 1 : [16]

            checksum = foldl (\s c -> s + wc - (zext c)) zero coeffs

    /**
     * The specification refers to a hash function H
     * that works over byte strings. We use a hash interface
     * that is bit-oriented, so this helper rejiggers that
     * interface so that it works over byte strings.
     *
     * This also repackages the digest in bytes.
     */
    H: {m} (fin m, width (8 * m) < MessageUpperBound) => [m][8] -> [n][8]
    H msg = split (hash (join msg))

    /**
     * A hash helper. This hash is used in public key generation,
     * signature generation, and signature verification, so is
     * distinguished as a named function in this specification.
     *
     * - i: the outer loop counter.
     * - I: the LMS tree id.
     * - q: the LMS leaf id.
     * - j: the inner loop counter.
     * - tmp: the "current" hash value.
     */
    Ht: [16] -> [16][8] -> [32] -> [n][8] -> [8] -> [n][8]
    Ht i I q tmp j = H (I # u32str q # u16str i # u8str j # tmp)

    /**
     * Iterate the hash some number of times.
     *
     * In signature generation and verification, the number of hash
     * iterations depends on values rather than types, so we write this
     * as if it were "a loop".
     */
    HtIter: [8] -> [16] -> [16][8] -> [32] -> [n][8] -> [8] -> [n][8]
    HtIter num i I q tmp j = if j >= num
                             then tmp
                             else HtIter num i I q (Ht i I q tmp j) (j + 1)

    /**
     * Helper that creates that the ith component of the public key.
     * This corresponds to one iteration of the loop described in
     * pseudocode in part (4) of algorithm 1.
     */
    publicComponent: [16] -> [16][8] -> [32] -> [n][8] -> [n][8]
    publicComponent i I q xi = foldl nextTmp xi [0..2 ^^ w - 2]
        where
            nextTmp tmp j = Ht i I q tmp j

    /**
     * Helper to determine x, I, and q from a private key. This includes the typecode,
     * and lets the caller ignore it if they want. This function does not appear in
     * the specification, and is a private helper.
     */
    unpackPrivate: [PrivateKeyLen][8] -> (Typecode, [16][8], [32], [p][n][8])
    unpackPrivate (typecodeArr # I # qArr # flatX) = (join typecodeArr, I, join qArr, split flatX)

    /**
     * Incidentally, since we don't model random generation, unpackPrivate is
     * the "inverse" of the private key generation.
     *
     * Note that since the typecode is hardcoded, the converse is untrue.
     *
     * ```
     * :prove unpackPrivateInvertible
     * ```
     */
    property unpackPrivateInvertible I q x = (typecode, I, q, x) == unpackPrivate t
        where
            t = privateKeyGeneration I q x

    /**
     * A fixed two byte value.
     *
     * See Section 4.3 of [LMS].
     */
    D_PBLC: [16]
    D_PBLC = 0x8080

    /**
     * A fixed two byte value.
     *
     * See Section 4.5 of [LMS].
     */
    D_MESG: [16]
    D_MESG = 0x8181

    /**
     * w is in the set 1, 2, 4, 8, so any byte string can be packaged as a
     * set of w coefficients. This function does not appear in the specification,
     * it is a private helper.
     *
     * Essentially, this is a replacement for coef that is written in (arguably)
     * more idiomatic Cryptol.
     */
    wStr:
        {l}
        (fin l)
        => [l][8] -> [8 * l / w][w]
    wStr S = split (join S)

    /*
     * Unsigned integers are converted into byte strings by representing them
     * in network byte order. See [LMS] Section 3.
     */

    /**
     * Convert an 8-bit integer into a byte string.
     *
     * See Section 3.1 of [LMS].
     */
    u8str: [8] -> [1][8]
    u8str x = [x]

    /**
     * Convert a 16-bit integer into a byte string.
     *
     * See Section 3.1 of [LMS].
     */
    u16str: [16] -> [2][8]
    u16str = split

    /**
     * Convert a 32-bit integer into a byte string.
     *
     * See Section 3.1 of [LMS].
     */
    u32str: [32] -> [4][8]
    u32str = split

    /**
     * Convert a byte string to an unsigned integer.
     *
     * See Section 3.1 of [LMS].
     */
    strTou32: [4][8] -> [32]
    strTou32 = join

    /**
     * The following identity holds for any four byte
     * string.
     *
     * ```
     * :prove strConvertIdentity
     * ```
     */
    property strConvertIdentity s = u32str(strTou32(s)) == s
