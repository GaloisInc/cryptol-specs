/**
 * Cryptol AEGIS-256 implementation.
 *
 * @copyright Galois Inc.
 * @author Craig Troop <ctroop@galois.com>
 *
 * Authenticated encryption with a 256-bit key and nonce.
 * [RFC10032] Section 4.
 *
 * References
 * [RFC10032]: F. Denis and S. Lucas, The AEGIS Authenticated Encryption
 *     Algorithms. RFC 10032, September 2026.
 *     @see https://www.rfc-editor.org/rfc/rfc10032
 */

module Primitive::Symmetric::Cipher::Authenticated::AEGIS::spec::AEGIS256 where

import Primitive::Symmetric::Cipher::Authenticated::AEGIS::spec::Common
    (Block, Bytes, AESRound, C0, C1, LE64)

/**
 * A 256-bit encryption key.
 * [RFC10032] Section 4.
 */
type Key = [256]

/**
 * A 256-bit public nonce.
 * [RFC10032] Section 4.
 */
type Nonce = [256]

/**
 * The state consists of 6 128-bit AES blocks; `S @ i` represents `Si`.
 * [RFC10032] Section 4.
 */
type AegisState = [6]Block

/**
 * An input block containing 128 bits.
 * [RFC10032] Section 2.
 */
type InputBlock = Block

/**
 * Update the state using 128-bit input blocks.
 * [RFC10032] Section 4.3.
 */
Update : AegisState -> Block -> AegisState
Update S M =
    [ AESRound (S @ 5) ((S @ 0) ^ M)
    , AESRound (S @ 0) (S @ 1)
    , AESRound (S @ 1) (S @ 2)
    , AESRound (S @ 2) (S @ 3)
    , AESRound (S @ 3) (S @ 4)
    , AESRound (S @ 4) (S @ 5)
    ]

/**
 * Initialize the state from `key` and `nonce`.
 * [RFC10032] Section 4.4.
 */
Init : Key -> Nonce -> AegisState
Init key nonce = (iterate step initial) @ 4
    where
        (k0, k1) = splitAt`{128} key
        (n0, n1) = splitAt`{128} nonce

        initial =
            [ k0 ^ n0
            , k1 ^ n1
            , C1
            , C0
            , k0 ^ C0
            , k1 ^ C1
            ]

        step S = foldl Update S [k0, k1, k0 ^ n0, k1 ^ n1]

/**
 * Absorb one input block into the state.
 * [RFC10032] Section 4.5.
 */
Absorb : AegisState -> InputBlock -> AegisState
Absorb = Update

/**
 * Compute the output mask used by `Enc`, `Dec`, and `DecPartial`.
 * [RFC10032] Sections 4.6 through 4.8.
 */
keystreamBlock : AegisState -> InputBlock
keystreamBlock S =
    (S @ 1) ^ (S @ 4) ^ (S @ 5) ^ ((S @ 2) && (S @ 3))

/**
 * Encrypt an input block and return the next state and ciphertext block.
 * [RFC10032] Section 4.6.
 */
Enc : AegisState -> InputBlock -> (AegisState, InputBlock)
Enc S xi = (Absorb S xi, xi ^ keystreamBlock S)

/**
 * Decrypt an input block and return the next state and unverified plaintext.
 * [RFC10032] Section 4.7.
 */
Dec : AegisState -> InputBlock -> (AegisState, InputBlock)
Dec S ci = (Absorb S xi, xi)
    where
        xi = ci ^ keystreamBlock S

/**
 * Decrypt a final fragment and return the next state and unverified
 * plaintext.
 * [RFC10032] Section 4.8.
 *
 * This helper also accepts an empty fragment and leaves the state unchanged;
 * the RFC calls `DecPartial` only for nonempty fragments.
 */
DecPartial : {n} (fin n, n <= 127) =>
    AegisState -> [n] -> (AegisState, [n])
DecPartial S cn = (next, xn)
    where
        z = keystreamBlock S
        t : InputBlock
        t = cn # zero
        out = t ^ z
        xn = take`{n} out
        v : InputBlock
        v = xn # zero
        next = if (`n : Integer) == 0
                then S
                else Absorb S v

/**
 * Perform the seven final `Update` calls using `ad_len_bits` and
 * `msg_len_bits`, the original associated-data and message lengths in bits.
 * [RFC10032] Section 4.9.
 */
FinalizeState : AegisState -> [64] -> [64] -> AegisState
FinalizeState S ad_len_bits msg_len_bits = (iterate step S) @ 7
    where
        t = (S @ 3) ^ (LE64 ad_len_bits # LE64 msg_len_bits)
        step S_step = Update S_step t

/**
 * Produce a 128-bit authentication tag using the original associated-data
 * and message lengths in bits.
 * [RFC10032] Section 4.9.
 *
 * This specializes the RFC `Finalize` function to a 128-bit tag.
 */
Finalize128 : AegisState -> [64] -> [64] -> [128]
Finalize128 S ad_len_bits msg_len_bits = foldl (^) zero final
    where
        final = FinalizeState S ad_len_bits msg_len_bits

/**
 * Produce a 256-bit authentication tag using the original associated-data
 * and message lengths in bits.
 * [RFC10032] Section 4.9.
 *
 * This specializes the RFC `Finalize` function to a 256-bit tag.
 */
Finalize256 : AegisState -> [64] -> [64] -> [256]
Finalize256 S ad_len_bits msg_len_bits = left # right
    where
        final = FinalizeState S ad_len_bits msg_len_bits
        left = foldl (^) zero (take`{3} final)
        right = foldl (^) zero (drop`{3} final)

/**
 * Zero-pad a byte sequence to a whole number of input blocks and split it.
 * This implements `Split(ZeroPad(...))` in the RFC pseudocode.
 * [RFC10032] Sections 4.1 and 4.2.
 */
paddedBlocks : {n} (fin n) =>
    Bytes n -> [(n + 15) / 16]InputBlock
paddedBlocks xs = split (join xs # zero)

/**
 * Run a block operation sequentially, collecting its outputs.
 */
runBlocks : {n} (fin n) =>
    (AegisState -> InputBlock -> (AegisState, InputBlock)) ->
    AegisState -> [n]InputBlock -> (AegisState, [n]InputBlock)
runBlocks operation S blocks =
    ((last results).0, (tail results).1)
    where
        results = scanl step (S, zero) blocks
        step previous block = operation previous.0 block

/**
 * Encrypt bytes using the supplied tag finalizer.
 * The type parameters `a` and `m` count bytes; finalization receives bit
 * lengths.
 * [RFC10032] Section 4.1.
 */
EncryptWith : {a, m, tag_len_bits}
    (fin a, fin m, fin tag_len_bits, a < 2^^61, m < 2^^61) =>
    (AegisState -> [64] -> [64] -> [tag_len_bits]) ->
    Bytes m -> Bytes a -> Key -> Nonce -> (Bytes m, [tag_len_bits])
EncryptWith finish msg ad key nonce = (ct, tag)
    where
        initial = Init key nonce
        ad_blocks = paddedBlocks ad
        ready = foldl Absorb initial ad_blocks
        msg_blocks = paddedBlocks msg
        (final, blocks) = runBlocks Enc ready msg_blocks
        ct = take`{m} (split (join blocks))
        tag = finish final (`(8 * a)) (`(8 * m))

/**
 * Decrypt and authenticate bytes using the supplied tag finalizer.
 * Return the validity flag and plaintext; on failure, return zeroed
 * plaintext.
 * The type parameters `a` and `m` count bytes.
 * [RFC10032] Section 4.2.
 */
DecryptWith : {a, m, tag_len_bits}
    (fin a, fin m, fin tag_len_bits, a < 2^^61, m < 2^^61) =>
    (AegisState -> [64] -> [64] -> [tag_len_bits]) ->
    Bytes m -> [tag_len_bits] -> Bytes a -> Key -> Nonce -> (Bit, Bytes m)
DecryptWith finish ct tag ad key nonce =
    (valid, if valid then msg else zero)
    where
        initial = Init key nonce
        ad_blocks = paddedBlocks ad
        ready = foldl Absorb initial ad_blocks

        (full, cn_bytes) = splitAt`{16 * (m / 16)} ct
        cn = join cn_bytes
        ct_blocks : [m / 16]InputBlock
        ct_blocks = split (join full)

        (afterFull, plaintext_blocks) = runBlocks Dec ready ct_blocks
        (final, xn) = DecPartial afterFull cn
        msg = split (join plaintext_blocks # xn)

        expected_tag = finish final (`(8 * a)) (`(8 * m))
        valid = tag == expected_tag

/**
 * Authenticated encryption with a 128-bit tag.
 * Specializes the RFC `Encrypt` function to this tag size.
 * [RFC10032] Section 4.1.
 */
EncryptTag128 : {a, m}
    (fin a, fin m, a < 2^^61, m < 2^^61) =>
    Bytes m -> Bytes a -> Key -> Nonce -> (Bytes m, [128])
EncryptTag128 = EncryptWith Finalize128

/**
 * Authenticated encryption with a 256-bit tag.
 * Specializes the RFC `Encrypt` function to this tag size.
 * [RFC10032] Section 4.1.
 */
EncryptTag256 : {a, m}
    (fin a, fin m, a < 2^^61, m < 2^^61) =>
    Bytes m -> Bytes a -> Key -> Nonce -> (Bytes m, [256])
EncryptTag256 = EncryptWith Finalize256

/**
 * Authenticated decryption with a 128-bit tag.
 * Return the validity flag and plaintext; on failure, return zeroed
 * plaintext.
 * [RFC10032] Section 4.2.
 */
DecryptTag128 : {a, m}
    (fin a, fin m, a < 2^^61, m < 2^^61) =>
    Bytes m -> [128] -> Bytes a -> Key -> Nonce -> (Bit, Bytes m)
DecryptTag128 = DecryptWith Finalize128

/**
 * Authenticated decryption with a 256-bit tag.
 * Return the validity flag and plaintext; on failure, return zeroed
 * plaintext.
 * [RFC10032] Section 4.2.
 */
DecryptTag256 : {a, m}
    (fin a, fin m, a < 2^^61, m < 2^^61) =>
    Bytes m -> [256] -> Bytes a -> Key -> Nonce -> (Bit, Bytes m)
DecryptTag256 = DecryptWith Finalize256

/**
 * Check the `Update` function against [RFC10032] Appendix A.3.1.
 *
 * ```repl
 * :check UpdateExampleProp
 * ```
 */
property UpdateExampleProp = Update before M == after
    where
        before =
            [ 0x1fa1207ed76c86f2c4bb40e8b395b43e
            , 0xb44c375e6c1e1978db64bcd12e9e332f
            , 0x0dab84bfa9f0226432ff630f233d4e5b
            , 0xd7ef65c9b93e8ee60c75161407b066e7
            , 0xa760bb3da073fbd92bdc24734b1f56fb
            , 0xa828a18d6a964497ac6e7e53c5f55c73
            ]
        M = 0xb165617ed04ab738afb2612c6d18a1ec
        after =
            [ 0xe6bc643bae82dfa3d991b1b323839dcd
            , 0x648578232ba0f2f0a3677f617dc052c3
            , 0xea788e0e572044a46059212dd007a789
            , 0x2f1498ae19b80da13fba698f088a8590
            , 0xa54c2ee95e8c2a2c3dae2ec743ae6b86
            , 0xa3240fceb68e32d5d114df1b5363ab67
            ]

/**
 * Encryption and decryption agree on plaintext and next state.
 *
 * ```repl
 * :prove blockRoundTripProp
 * ```
 */
property blockRoundTripProp (S : AegisState) (msg : InputBlock) =
    Dec S ct == (next, msg)
    where
        (next, ct) = Enc S msg

/**
 * Check the ciphertext from [RFC10032] Appendix A.3.2.
 *
 * ```repl
 * :check blockExampleProp
 * ```
 */
property blockExampleProp = ct == expected
    where
        key = join
            [ 0x10010000000000000000000000000000
            , 0x00000000000000000000000000000000
            ] : Key

        nonce = join
            [ 0x10000200000000000000000000000000
            , 0x00000000000000000000000000000000
            ] : Nonce

        expected = 0x754fc3d8c973246dcc6d741412a4b236
        (_, ct) = Enc (Init key nonce) zero

/**
 * Check plaintext and both tags against [RFC10032] Appendix A.3.5.
 *
 * ```repl
 * :check partialExampleProp
 * ```
 */
property partialExampleProp =
    (msg == expectedMsg) &&
    (Finalize128 next 64 112 == expected128) &&
    (Finalize256 next 64 112 == expected256)
    where
        key = join
            [ 0x10010000000000000000000000000000
            , 0x00000000000000000000000000000000
            ] : Key

        nonce = join
            [ 0x10000200000000000000000000000000
            , 0x00000000000000000000000000000000
            ] : Nonce

        adBlock = (0x0001020304050607 : [64]) # (zero : [64])

        ct = 0xf373079ed84b2709faee37358458 : [112]
        expectedMsg = 0x000102030405060708090a0b0c0d : [112]

        expected128 = 0xc60b9c2d33ceb058f96e6dd03c215652
        expected256 = join
            [ 0x8c1cc703c81281bee3f6d9966e14948b
            , 0x4a175b2efbdc31e61a98b4465235c2d9
            ] : [256]

        S = Absorb (Init key nonce) adBlock
        (next, msg) = DecPartial S ct

/**
 * An empty fragment must not advance the state.
 *
 * ```repl
 * :prove emptyPartialProp
 * ```
 */
property emptyPartialProp (S : AegisState) =
    DecPartial S ([] : [0]) == (S, [])

/**
 * Check [RFC10032] Appendix A.3.6 and rejection of modified tags.
 *
 * ```repl
 * :check aeadExampleProp
 * ```
 */
property aeadExampleProp =
    (EncryptTag128 msg ad key nonce == (ct, tag128)) &&
    (EncryptTag256 msg ad key nonce == (ct, tag256)) &&
    (DecryptTag128 ct tag128 ad key nonce == (True, msg)) &&
    (DecryptTag256 ct tag256 ad key nonce == (True, msg)) &&
    (DecryptTag128 ct (tag128 ^ 1) ad key nonce == (False, zero)) &&
    (DecryptTag256 ct (tag256 ^ 1) ad key nonce == (False, zero))
    where
        key = join
            [ 0x10010000000000000000000000000000
            , 0x00000000000000000000000000000000
            ] : Key

        nonce = join
            [ 0x10000200000000000000000000000000
            , 0x00000000000000000000000000000000
            ] : Nonce

        ad = [0 .. 41] : Bytes 42
        msg = [16 .. 55] : Bytes 40

        c0 = 0x57754a7d09963e7c787583a2e7b859bb : [128]
        c1 = 0x24fa1e04d49fd550b2511a358e3bca25 : [128]
        c2 = 0x2a9b1b8b30cc4a67 : [64]
        ct = split (c0 # c1 # c2)

        tag128 = 0xab8a7d53fd0e98d727accca94925e128
        tag256 = join
            [ 0xa3aca270c006094d71c20e6910b5161c
            , 0x0826df233d08919a566ec2c05990f734
            ] : [256]
